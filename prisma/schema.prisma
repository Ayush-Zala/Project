generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

// ─── AUTH ────────────────────────────────────────────────

model User {
  id            Int      @id @default(autoincrement())
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  isActive      Boolean  @default(true)
  image         String?
  createdBy     Int?
  createdAt     BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt     BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  // Self-relation: admin who created this user
  createdByUser   User?  @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers    User[] @relation("UserCreatedBy")

  // Auth
  sessions        Session[]
  accounts        Account[]

  // RBAC
  userRoles           UserRole[]         @relation("UserToUserRole")
  userPermissions     UserPermission[]   @relation("UserToUserPermission")

  // Audit trail (who performed the action)
  auditLogs           AuditLog[]         @relation("AuditLogActor")

  // Activity log
  activityLogs        ActivityLog[]

  // Junction table audit (who granted the role/permission)
  grantedUserRoles        UserRole[]       @relation("UserRoleGrantedBy")
  grantedUserPermissions  UserPermission[] @relation("UserPermissionGrantedBy")
  grantedRolePermissions  RolePermission[] @relation("RolePermissionGrantedBy")

  // RBAC entity audit trails
  createdRoles        Role[]       @relation("RoleCreatedBy")
  updatedRoles        Role[]       @relation("RoleUpdatedBy")
  createdPermissions  Permission[] @relation("PermissionCreatedBy")
  updatedPermissions  Permission[] @relation("PermissionUpdatedBy")

  // AuditLog createdBy
  auditLogsCreated    AuditLog[]   @relation("AuditLogCreatedBy")

  // Team 
  teamsAsMember       TeamMember[]
  createdTeams        Team[]           @relation("TeamCreatedBy")
  updatedTeams        Team[]           @relation("TeamUpdatedBy")
  createdTeamRoles    TeamRole[]       @relation("TeamRoleCreatedBy")
  updatedTeamRoles    TeamRole[]       @relation("TeamRoleUpdatedBy")
  createdTeamMembers  TeamMember[]     @relation("TeamMemberCreatedBy")
  updatedTeamMembers  TeamMember[]     @relation("TeamMemberUpdatedBy")
  createdTeamMemberRoles TeamMemberRole[] @relation("TeamMemberRoleCreatedBy")
  updatedTeamMemberRoles TeamMemberRole[] @relation("TeamMemberRoleUpdatedBy")

  // Organisation
  organisationMembers    OrganisationMember[]
  organisationTeamMembers OrganisationTeamMember[]

  @@map("user")
}

model Session {
  id        Int      @id @default(autoincrement())
  userId    Int
  token     String   @unique
  ipAddress String?
  userAgent String?
  expiresAt BigInt
  createdAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  activeOrganizationId Int?
  activeTeamId         Int?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    Int       @id @default(autoincrement())
  userId                Int
  providerId            String
  accountId             String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  BigInt?
  refreshTokenExpiresAt BigInt?
  scope                 String?
  password              String?
  createdAt             BigInt    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt             BigInt    @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         Int       @id @default(autoincrement())
  identifier String
  value      String
  expiresAt  BigInt
  createdAt  BigInt?   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt  BigInt?   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  @@map("verification")
}

// ─── RBAC CORE ───────────────────────────────────────────

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique
  description String?
  colorCode   String?
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  // Self-relation: role inheritance
  parentId    Int?
  parent      Role?  @relation("RoleInheritance", fields: [parentId], references: [id])
  children    Role[] @relation("RoleInheritance")

  // Audit
  createdByUser User? @relation("RoleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("RoleUpdatedBy", fields: [updatedBy], references: [id])

  // Junctions
  userRoles       UserRole[]
  rolePermissions RolePermission[]

  @@map("role")
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  slug        String   @unique // e.g. users:create
  resource    String   // e.g. users, roles, reports
  action      String   // create|read|update|delete|manage
  description String?
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  // Audit
  createdByUser User? @relation("PermissionCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("PermissionUpdatedBy", fields: [updatedBy], references: [id])

  // Junctions
  userPermissions UserPermission[]
  rolePermissions RolePermission[]

  @@map("permission")
}

// ─── JUNCTION TABLES ─────────────────────────────────────

model UserRole {
  id        Int      @id @default(autoincrement())
  userId    Int
  roleId    Int
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  user          User  @relation("UserToUserRole", fields: [userId], references: [id], onDelete: Cascade)
  role          Role  @relation(fields: [roleId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("UserRoleGrantedBy", fields: [createdBy], references: [id])

  @@unique([userId, roleId])
  @@map("user_role")
}

model UserPermission {
  id           Int      @id @default(autoincrement())
  userId       Int
  permissionId Int
  isActive     Boolean  @default(true)
  createdBy    Int?
  updatedBy    Int?
  createdAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  user          User       @relation("UserToUserPermission", fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("UserPermissionGrantedBy", fields: [createdBy], references: [id])

  @@unique([userId, permissionId])
  @@map("user_permission")
}

model RolePermission {
  id           Int      @id @default(autoincrement())
  roleId       Int
  permissionId Int
  isActive     Boolean  @default(true)
  createdBy    Int?
  updatedBy    Int?
  createdAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  role          Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("RolePermissionGrantedBy", fields: [createdBy], references: [id])

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

// ─── AUDIT & LOGS ─────────────────────────────────────────

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String   // CREATE, UPDATE, DELETE, etc.
  resource  String   // The model name (e.g., "user", "role")
  metaData  Json?    // stores before & after snapshot with entity ID
  ipAddress String?
  userAgent String?
  status    String   // SUCCESS, FAILURE
  reason    String?  // summary or error reason
  createdBy Int?
  createdAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  user          User? @relation("AuditLogActor", fields: [userId], references: [id])
  createdByUser User? @relation("AuditLogCreatedBy", fields: [createdBy], references: [id])

  @@map("audit_log")
}

model ActivityLog {
  id          Int           @id @default(autoincrement())
  userId      Int
  eventTime   BigInt        @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  eventType   ActivityEvent
  description String?
  ipAddress   String?
  userAgent   String?

  user User @relation(fields: [userId], references: [id])

  @@map("activity_log")
}

// ─── ACTIVITY ENUMS ───────────────────────────────────────────


enum ActivityEvent {
  LOGIN
  LOGOUT
  PERMISSION_DENIED
}

// ─── TEAM STRUCTURE ──────────────────────────────────────

model Team {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  createdByUser User? @relation("TeamCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("TeamUpdatedBy", fields: [updatedBy], references: [id])

  roles   TeamRole[]
  members TeamMember[]

  @@map("team")
}

model TeamRole {
  id          Int      @id @default(autoincrement())
  teamId      Int
  name        String
  slug        String
  description String?
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("TeamRoleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("TeamRoleUpdatedBy", fields: [updatedBy], references: [id])

  memberRoles TeamMemberRole[]

  @@unique([teamId, slug])
  @@map("team_role")
}

model TeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  team          Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user          User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdByUser User? @relation("TeamMemberCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User? @relation("TeamMemberUpdatedBy", fields: [updatedBy], references: [id])

  roles TeamMemberRole[]

  @@unique([teamId, userId])
  @@map("team_member")
}

model TeamMemberRole {
  id           Int      @id @default(autoincrement())
  teamMemberId Int
  teamRoleId   Int
  createdBy    Int?
  updatedBy    Int?
  createdAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt    BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  member        TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade)
  role          TeamRole   @relation(fields: [teamRoleId], references: [id], onDelete: Cascade)
  createdByUser User?      @relation("TeamMemberRoleCreatedBy", fields: [createdBy], references: [id])
  updatedByUser User?      @relation("TeamMemberRoleUpdatedBy", fields: [updatedBy], references: [id])

  @@unique([teamMemberId, teamRoleId])
  @@map("team_member_role")
}

// ─── ORGANISATION ─────────────────────────────────────────

model Organisation {
  id          Int      @id @default(autoincrement())
  name        String
  slug        String   @unique
  logo        String?  @db.Text
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  members     OrganisationMember[]
  invitations OrganisationInvitation[]
  teams       OrganisationTeam[]
  roles       OrganisationRole[]
  companies   Company[]

  @@map("organisation")
}

model OrganisationMember {
  id             Int      @id @default(autoincrement())
  userId         Int
  organizationId Int
  role           String   // owner | admin | member | custom
  isActive       Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@map("organisation_member")
  companyAssignments CompanyMember[]
}


model OrganisationInvitation {
  id             Int      @id @default(autoincrement())
  email          String
  inviterId      Int
  organizationId Int
  role           String?
  status         String   // pending | accepted | rejected | cancelled
  expiresAt      BigInt
  isActive       Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  organisation   Organisation @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organisation_invitation")
}

model OrganisationTeam {
  id             Int      @id @default(autoincrement())
  name           String
  organizationId Int
  isActive       Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  organisation   Organisation @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        OrganisationTeamMember[]

  @@map("organisation_team")
}

model OrganisationTeamMember {
  id        Int      @id @default(autoincrement())
  teamId    Int
  userId    Int
  isActive  Boolean  @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  team      OrganisationTeam @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@map("organisation_team_member")
}

model OrganisationRole {
  id             Int      @id @default(autoincrement())
  organizationId Int
  role           String
  permission     String   // JSON string of permissions
  isActive       Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  organisation   Organisation @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organisation_role")
}

// ─── COMPANY & CLIENT MODULE ─────────────────────────────

enum CompanySource {
  REFERRAL
  COLD_CALL
  COLD_EMAIL
  LINKEDIN
  WEBSITE
  CONFERENCE
  PAID_AD
  CONTENT_MARKETING
  PARTNER
  OTHER
}

enum ContactType {
  MOBILE
  LANDLINE
  WORK_PHONE
  FAX
  EMAIL
  WORK_EMAIL
  WHATSAPP
  TELEGRAM
  SIGNAL
  SKYPE
  ZOOM
  OTHER
}

enum SocialPlatform {
  LINKEDIN
  TWITTER_X
  FACEBOOK
  INSTAGRAM
  YOUTUBE
  TIKTOK
  GITHUB
  GITLAB
  WEBSITE
  BLOG
  OTHER
}

model Industry {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  description String?  @db.Text
  isActive    Boolean  @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  companies   Company[]

  @@map("industry")
}

model Company {
  id              Int           @id @default(autoincrement())
  organisationId  Int
  industryId      Int
  name            String
  website         String?
  source          CompanySource @default(OTHER)
  otherSource     String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  isActive        Boolean       @default(true)
  createdBy       Int?
  updatedBy       Int?
  createdAt       BigInt        @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt       BigInt        @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  organisation    Organisation  @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  industry        Industry      @relation(fields: [industryId], references: [id])
  contacts        CompanyContact[]
  clients         CompanyClient[]

  @@map("company")
  assignedMembers CompanyMember[]
}

model CompanyMember {
  id             Int      @id @default(autoincrement())
  companyId      Int
  organizationMemberId Int @unique
  isActive       Boolean  @default(true)
  createdBy      Int?
  updatedBy      Int?
  createdAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt      BigInt   @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  company        Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  member         OrganisationMember @relation(fields: [organizationMemberId], references: [id], onDelete: Cascade)

  @@map("company_member")
}


model CompanyContact {
  id        Int         @id @default(autoincrement())
  companyId Int
  type      ContactType @default(MOBILE)
  otherType String?
  value     String
  isPrimary Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt      @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt      @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  company   Company     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("company_contact")
}

model CompanyClient {
  id          Int                  @id @default(autoincrement())
  companyId   Int
  fullName    String
  designation String?
  isActive    Boolean              @default(true)
  createdBy   Int?
  updatedBy   Int?
  createdAt   BigInt               @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt   BigInt               @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts    CompanyClientContact[]
  socials     CompanyClientSocialProfile[]

  @@map("company_client")
}

model CompanyClientContact {
  id        Int         @id @default(autoincrement())
  clientId  Int
  type      ContactType @default(MOBILE)
  otherType String?
  value     String
  isPrimary Boolean     @default(false)
  isActive  Boolean     @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt      @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt      @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  client    CompanyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("company_client_contact")
}

model CompanyClientSocialProfile {
  id        Int            @id @default(autoincrement())
  clientId  Int
  platform  SocialPlatform @default(LINKEDIN)
  otherPlatform String?
  url       String
  isActive  Boolean        @default(true)
  createdBy Int?
  updatedBy Int?
  createdAt BigInt         @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))
  updatedAt BigInt         @default(dbgenerated("(extract(epoch from now()) * 1000)::bigint"))

  client    CompanyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@map("company_client_social_profile")
}